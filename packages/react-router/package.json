{
  "name": "@live-tabs/react-router",
  "version": "0.2.2",
  "description": "React Router adapter for live-tabs: workspace tabs whose pages stay alive across switches, with useLocation/useParams/useLoaderData frozen per kept page.",
  "keywords": [
    "react-router",
    "react",
    "tabs",
    "keep-alive",
    "keepalive",
    "workspace"
  ],
  "license": "MIT",
  "author": "live-tabs contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cwit-ae/livetabs.git",
    "directory": "packages/react-router"
  },
  "homepage": "https://github.com/cwit-ae/livetabs#readme",
  "bugs": "https://github.com/cwit-ae/livetabs/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "styles.css",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./styles.css"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint:pkg": "publint --strict"
  },
  "dependencies": {
    "@live-tabs/core": "0.2.2"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "react-router": ">=7",
    "zustand": ">=4"
  }
}
